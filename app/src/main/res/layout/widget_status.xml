<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="58dp"
    android:layout_height="58dp">

    <!-- top-category color circle, fills the widget -->
    <ImageView
        android:id="@+id/statusCircle"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center"
        android:src="@drawable/circle_shape"
        android:contentDescription="@string/widget_desc"/>

    <!-- app logo, same 34dp size as before -->
    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center"
        android:src="@drawable/peach_logo"
        android:contentDescription="@null"/>

    <!-- thin peach border on top -->
    <ImageView
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center"
        android:src="@drawable/widget_border"
        android:contentDescription="@null"/>

</FrameLayout>
