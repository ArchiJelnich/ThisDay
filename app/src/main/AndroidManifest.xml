<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.devgardenaj.thisday">
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".infra.ThisDayApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/peach_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/peach_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThisDay"
        tools:targetApi="31"
        tools:ignore="MissingTvBanner">

        <activity
            android:name=".screens.TodayActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".screens.CategoryActivity"
            android:exported="true">
        </activity>
        <activity
            android:name=".screens.SettingActivity"
            android:exported="true">
        </activity>
        <activity
            android:name=".screens.GraphActivity"
            android:exported="true">
        </activity>
        <receiver android:name=".infra.AlarmReceiver" />


        <receiver android:name=".widget.WidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/status_widget_info" />
        </receiver>

    </application>



</manifest>